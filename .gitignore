# ignore build artifacts, cache files, and temporary files
build/
downloads/
builds/
# Ignore cache directories anywhere (root runtime cache and provider test
# caches), but keep the internal/cache source package tracked.
cache/
!internal/cache/
tmp/ 
workspace/
# AI embedding cache
.ai-cache/

# Local editor and generated artifacts
.vscode/
/image-composer-tool
/live-installer
/image-composer-tool.log

# Advanced-mode extends deltas: generated server-side into image-templates/ at
# compose/build time (extends can only reference a parent at or below the
# child's own directory) and removed once resolved/built. Should never be
# committed if one is ever left behind by a crashed server.
image-templates/.ict-adv-*.yml
